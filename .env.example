# Local Postgres (DEC-020). Copy to .env.local (gitignored) and adjust if needed.
# The compose service (docker compose up -d) serves both DBs on localhost:5432.
DATABASE_URL=postgres://muster:muster@localhost:5432/muster_dev
TEST_DATABASE_URL=postgres://muster:muster@localhost:5432/muster_test

# Magic-link session signing (DEC-010/021). Dev falls back to an insecure default;
# PRODUCTION MUST set a long random secret here (rotating it invalidates sessions).
SESSION_SECRET=dev-insecure-session-secret

# Xola live-API import (DEC-036, task 5.4b). Server-only — NEVER prefix NEXT_PUBLIC.
# Read-scoped key; point at the sandbox for dev. Auth is X-API-Key + X-API-Version.
XOLA_API_KEY=
XOLA_SELLER_ID=
XOLA_API_BASE=https://sandbox.xola.com/api
XOLA_API_VERSION=2021-03-10
