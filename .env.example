# Local Postgres (DEC-020). Copy to .env.local (gitignored) and adjust if needed.
# The compose service (docker compose up -d) serves both DBs on localhost:5432.
DATABASE_URL=postgres://muster:muster@localhost:5432/muster_dev
TEST_DATABASE_URL=postgres://muster:muster@localhost:5432/muster_test

# Magic-link session signing (DEC-010/021). Dev falls back to an insecure default;
# PRODUCTION MUST set a long random secret here (rotating it invalidates sessions).
SESSION_SECRET=dev-insecure-session-secret

# Crew self-serve sign-in (DEC-081, Phase 7). The code-login front door is
# flag-gated OFF until real email is wired; set CREW_SELF_SERVE=1 to enable it.
# Email delivery is Resend over fetch (7.0b) — both vars required together, else
# delivery falls back to the dev log/echo (no real send). EMAIL_FROM must be on a
# DKIM-verified domain (crew.brewcle.com).
CREW_SELF_SERVE=
RESEND_API_KEY=
EMAIL_FROM=Muster <crew@crew.brewcle.com>

# Twilio SMS (9.4/#225, DEC-MSG-1 swap). Server-only — NEVER prefix NEXT_PUBLIC.
# DARK UNTIL SET (#70): needs SID + token + a SENDER, else crew relays stay on
# the operator outbox (/admin/outbox); a half-config falls back too (logs in prod).
# Sender, one of (SERVICE SID preferred — wins when both set):
#   TWILIO_MESSAGING_SERVICE_SID  MG… of the approved A2P 10DLC campaign's
#                                 Messaging Service — routes via the campaign's
#                                 sender pool; the fix for error 30034.
#   TWILIO_FROM                   a single E.164 number (+1…) — only works for
#                                 US sends if toll-free-verified or attached to
#                                 an approved campaign.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Xola live-API import (DEC-036, task 5.4b). Server-only — NEVER prefix NEXT_PUBLIC.
# Read-scoped key; point at the sandbox for dev. Auth is X-API-Key + X-API-Version.
XOLA_API_KEY=
XOLA_SELLER_ID=
XOLA_API_BASE=https://sandbox.xola.com/api
XOLA_API_VERSION=2021-03-10

# Engine tuning knobs — optional; all have sane code defaults. Uncomment to override
# locally (or set them in Vercel to tune the live pilot without a redeploy).
# STAFFING_HORIZON_LEAD_DAYS=7     # days ahead the engine starts working a shift (DEC-022/062)
# XOLA_PULL_LEAD_DAYS=7            # days ahead the importer fetches Xola orders; defaults to STAFFING_HORIZON_LEAD_DAYS. Decoupled (DEC-080) — set wider (e.g. 30) to pull a month without asking crew that far out
# ASK_DRIP_INTERVAL_MINUTES=15     # minutes between staged Tier-1 asks (DEC-063; 0 = blast all at once)
# ASK_SILENT_TIMEOUT_MINUTES=120   # minutes before an unanswered ask counts as silent (DEC-067)
# STAFFING_HORIZON_WEEKEND_DAYS=""         # DEC-116 weekend-batch trigger. Space-list of Mon=0..Sun=6 (e.g. "4 5 6" = Fri Sat Sun) whose shifts go live TOGETHER. EMPTY = off (flat per-shift horizon). Do NOT set in prod until #393 (batched asks) lands, or the batch blasts one crew member N asks at once.
# STAFFING_HORIZON_TRIGGER_DAY=0           # DEC-116 weekday the weekend batch fires on, Mon=0..Sun=6 (0 = that week's Monday, 6 = the Sunday before). Only 0 and 6 are sensible.
# STAFFING_HORIZON_WEEKEND_ASK_TIME=09:00  # DEC-116 vessel-local HH:MM the weekend batch fires at

# Single-tenant pilot identity — optional; the code defaults below ship, and the dev
# seeds + canonical seeds both use these exact values, so you normally DON'T set them.
# Override only for a differently-named tenant/operator (a multi-tenant-era concern).
# TENANT_ID=tenant-brewboat            # the pilot tenant; role types (e.g. the manning picker) scope to it (tenant.ts)
# OPERATOR_CREW_MEMBER_ID=crew-spink   # who "the office" posts/acts as (operator.ts, DEC-058)

# Civil send window (DEC-088, 9.9) — vessel-local HH:MM bounds outside which the
# engine's OWN ask sends defer (tick drip/blast/escalate, bail/vacate re-asks).
# Operator-explicit sends never gate. Optional; defaults 08:00–20:00, half-open
# [start,end). Malformed or inverted values degrade to the defaults (logged).
# CIVIL_SEND_START=08:00
# CIVIL_SEND_END=20:00

# Smart Doorbell tuning (DEC-060 / DEC-068, Phase 6). All optional — the researched
# defaults below ship if unset; tune-on-real-use. Plain integers only (no 90_000).
# Invariant: DOORBELL_PRESENCE_WINDOW_MS must exceed DOORBELL_BATCH_WINDOW_MS
# (the decider asserts this at startup).
# DOORBELL_BATCH_WINDOW_MS=90000        # hold-before-ring / cancel window, §7.2 (default 90s)
# DOORBELL_PRESENCE_WINDOW_MS=300000    # presence-staleness window, §7.1 (default 5min)
# DOORBELL_SHORT_NOTICE_MAX_CHARS=160   # lone-note inline-vs-summary threshold, §7.5 (default 160)
