# Local Postgres (DEC-020). Copy to .env.local (gitignored) and adjust if needed.
# The compose service (docker compose up -d) serves both DBs on localhost:5432.
DATABASE_URL=postgres://muster:muster@localhost:5432/muster_dev
TEST_DATABASE_URL=postgres://muster:muster@localhost:5432/muster_test

# Magic-link session signing (DEC-010/021). Dev falls back to an insecure default;
# PRODUCTION MUST set a long random secret here (rotating it invalidates sessions).
SESSION_SECRET=dev-insecure-session-secret

# The trusted public origin every DELIVERED link is minted against (base-url.ts).
# Locally you can leave it unset (callers fall back to http://localhost:3000).
# PRODUCTION MUST SET IT: unset, (a) magic links become host-spoofable, and (b) the
# cron silently enqueues outbox links pointing at localhost — it runs with no request
# Host header, so the fallback is wrong exactly where nobody is watching.
APP_BASE_URL=

# Cron auth (Vercel sends it as `Authorization: Bearer …`). openssl rand -base64 32.
# Read by /api/cron/tick, /api/cron/xola-pull and /api/cron/doorbell-tick.
CRON_SECRET=

# ── Feature flags ───────────────────────────────────────────────────────────
# ALL FOUR ACCEPT "1" OR "true" (app/lib/flags.ts, #736). They used to disagree —
# three tested === "1" and RESERVATIONS tested === "true", so RESERVATIONS=1 left
# the whole customer flow silently off. One flagOn() helper reads them all now.
# All are OFF by default so main stays promotable.
#
# CREW_SELF_SERVE is set below, with the email vars it cannot work without.
#
# MESSAGING is still read in TWO places with DIFFERENT rules, and #736 did NOT
# change that half: messagingEnabled() asks whether it is ON, but
# app/lib/booking-confirmation.ts, app/lib/sold-out-notice.ts and
# app/b/find/actions.ts treat === "false" as a hard kill for confirmation and
# sold-out sends. So MESSAGING=0 leaves confirmations ON, and MESSAGING=false
# silently kills them. Use "1" or "true", or leave it unset — never 0/false.
MESSAGING=
# Crew time clock + the payroll/gusto/tips exports.
TIME_CLOCK=
# The customer flow: /book, checkout, the manage page (DEC-111).
RESERVATIONS=

# Crew self-serve sign-in (DEC-081, Phase 7). The code-login front door is
# flag-gated OFF until real email is wired; set CREW_SELF_SERVE=1 (or true) to enable.
# Email delivery is Resend over fetch (7.0b) — both vars required together, else
# delivery falls back to the dev log/echo (no real send). EMAIL_FROM must be on a
# DKIM-verified domain (crew.brewcle.com).
CREW_SELF_SERVE=
RESEND_API_KEY=
EMAIL_FROM=Muster <crew@crew.brewcle.com>

# Twilio SMS (9.4/#225, DEC-MSG-1 swap). Server-only — NEVER prefix NEXT_PUBLIC.
# DARK UNTIL SET (#70): needs SID + token + a SENDER, else crew relays stay on
# the operator outbox (/admin/outbox); a half-config falls back too (logs in prod).
# Sender, one of (SERVICE SID preferred — wins when both set):
#   TWILIO_MESSAGING_SERVICE_SID  MG… of the approved A2P 10DLC campaign's
#                                 Messaging Service — routes via the campaign's
#                                 sender pool; the fix for error 30034.
#   TWILIO_FROM                   a single E.164 number (+1…) — only works for
#                                 US sends if toll-free-verified or attached to
#                                 an approved campaign.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=

# Xola live-API import (DEC-036, task 5.4b). Server-only — NEVER prefix NEXT_PUBLIC.
# Read-scoped key; point at the sandbox for dev. Auth is X-API-Key + X-API-Version.
XOLA_API_KEY=
XOLA_SELLER_ID=
XOLA_API_BASE=https://sandbox.xola.com/api
XOLA_API_VERSION=2021-03-10

# Reservations + payments (#618; DEC-111 flag, DEC-134 checkout, DEC-122 links).
# The RESERVATIONS flag itself is in the flags block above.
#
# Stripe. Server-only — NEVER prefix NEXT_PUBLIC.
# STRIPE_WEBHOOK_SECRET gates CHECKOUT as well as the webhook: StripePaymentPort
# requires it at construction, so a typo presents as a broken booking form
# ("Checkout isn't configured on this deployment. Nothing was charged.") — not as
# a webhook problem, and not where anyone would look.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The ONE deliberately-public Stripe value (it is a publishable key — the
# NEVER-prefix-NEXT_PUBLIC rule above does not apply). BUILD-INLINED: setting it
# on a running deploy does nothing until a rebuild. Absent ⇒ the checkout page
# renders a loud red config-error card rather than a broken Element.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# HMAC secret for every "manage my booking" capability URL (DEC-122).
# openssl rand -base64 32. ROTATING IT DEAD-LINKS every booking link already
# sitting in a customer's inbox, with no way to reissue them.
RESERVATION_LINK_SECRET=

# Where a customer's change/cancel request from the manage page is emailed.
# Unset ⇒ the request is logged and NOBODY IS TOLD.
OPERATOR_NOTIFY_EMAIL=

# The liability waiver a customer legally consents to at checkout (DEC-110).
# Both have code defaults (the values below); the version is server-authoritative.
# BUMP THE VERSION whenever the waiver text changes, or old consent records claim
# to be for text nobody agreed to.
WAIVER_TERMS_URL=https://www.brewcle.com/liability-waiver/
WAIVER_TERMS_VERSION=v1

# Daily Xola passenger report (cron on the box that runs it — NOT Vercel; this is a
# local `tsx` process and never runs in the deployed app). Comma-separated
# recipients; empty ⇒ the script refuses rather than mailing nobody and exiting 0.
# TEMPORARY: dies at the Xola cutover (DEC-126).
XOLA_REPORT_TO=
# Optional sender; defaults to Resend's onboarding address, which will land in spam.
XOLA_REPORT_FROM=

# Tenant / venue identity — all optional, code defaults shown. The dev seeds and the
# canonical seeds use these exact values, so you normally DON'T set them.
# TENANT_ID=tenant-brewboat            # the pilot tenant; role types scope to it (tenant.ts)
# TENANT_NAME=BrewBoat                 # admin-nav label (app/lib/tenant.ts)
# TENANT_TZ=America/New_York           # vessel timezone (DEC-032); set if the fleet ever isn't Eastern
# OPERATOR_CREW_MEMBER_ID=crew-spink   # who "the office" posts/acts as (operator.ts, DEC-058)
# PAY_PERIOD_ANCHOR=2026-01-05         # a known pay-period START; phases the 14-day periods
# PICKUP_LOCATION=Canal Basin Park near Flatiron Cafe   # the dock pin in the guest text (SPEC §2.6.3)
# PICKUP_MAP_URL=https://maps.app.goo.gl/A2vG7Q9LjKdZJpod9

# Dev/test only — several are guards on destructive or live-data scripts.
# CHECKOUT_HOLD_MINUTES=0.5   # shorten the 15-min checkout hold to reproduce the expiry race by hand. IGNORED on a production deploy (claim.ts checks isProdDeploy first)
# SEED_TODAY=2026-08-13       # pin the seeds' "today" so a seeded DB and the specs read one clock, not two that can disagree across midnight
# OUTBOX_TEST_PHONE=+1…       # point the outbox seed at one real number for testing
# BACKFILL_CONFIRM=1          # db:backfill:customers refuses without it
# RESET_PILOT_CONFIRM=1       # db/reset-pilot.ts refuses without it — DESTRUCTIVE
# RESET_PILOT_EXPECT_DB=…     # and it must match the target DB name, so you cannot wipe the wrong one

# Engine tuning knobs — optional; all have sane code defaults. Uncomment to override
# locally (or set them in Vercel to tune the live pilot without a redeploy).
# STAFFING_HORIZON_LEAD_DAYS=7     # days ahead the engine starts working a shift (DEC-022/062)
# XOLA_PULL_LEAD_DAYS=7            # days ahead the importer fetches Xola orders; defaults to STAFFING_HORIZON_LEAD_DAYS. Decoupled (DEC-080) — set wider (e.g. 30) to pull a month without asking crew that far out
# ASK_DRIP_INTERVAL_MINUTES=15     # minutes between staged Tier-1 asks (DEC-063; 0 = blast all at once)
# ASK_SILENT_TIMEOUT_MINUTES=120   # minutes before an unanswered ask counts as silent (DEC-067)
# STAFFING_HORIZON_WEEKEND_DAYS=""         # DEC-116 weekend-batch trigger. Space-list of Mon=0..Sun=6 (e.g. "4 5 6" = Fri Sat Sun) whose shifts go live TOGETHER. EMPTY = off (flat per-shift horizon). Do NOT set in prod until #393 (batched asks) lands, or the batch blasts one crew member N asks at once.
# STAFFING_HORIZON_TRIGGER_DAY=0           # DEC-116 weekday the weekend batch fires on, Mon=0..Sun=6 (0 = that week's Monday, 6 = the Sunday before). Only 0 and 6 are sensible.
# STAFFING_HORIZON_WEEKEND_ASK_TIME=09:00  # DEC-116 vessel-local HH:MM the weekend batch fires at

# Civil send window (DEC-088, 9.9) — vessel-local HH:MM bounds outside which the
# engine's OWN ask sends defer (tick drip/blast/escalate, bail/vacate re-asks).
# Operator-explicit sends never gate. Optional; defaults 08:00–20:00, half-open
# [start,end). Malformed or inverted values degrade to the defaults (logged).
# CIVIL_SEND_START=08:00
# CIVIL_SEND_END=20:00

# Smart Doorbell tuning (DEC-060 / DEC-068, Phase 6). All optional — the researched
# defaults below ship if unset; tune-on-real-use. Plain integers only (no 90_000).
# Invariant: DOORBELL_PRESENCE_WINDOW_MS must exceed DOORBELL_BATCH_WINDOW_MS
# (the decider asserts this at startup).
# DOORBELL_BATCH_WINDOW_MS=90000        # hold-before-ring / cancel window, §7.2 (default 90s)
# DOORBELL_PRESENCE_WINDOW_MS=300000    # presence-staleness window, §7.1 (default 5min)
# DOORBELL_SHORT_NOTICE_MAX_CHARS=160   # lone-note inline-vs-summary threshold, §7.5 (default 160)