{
  "name": "muster",
  "version": "0.5.3",
  "description": "Crew engine for small-passenger-vessel operators",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "build:core": "tsc -p tsconfig.build.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed:crew": "tsx db/seed-crewapp-dev.ts",
    "db:seed:atrisk": "tsx db/seed-atrisk-dev.ts",
    "db:seed:outbox": "tsx db/seed-outbox-dev.ts",
    "db:tick": "tsx db/tick-dev.ts",
    "test": "vitest run",
    "test:pg": "vitest run src/adapters/postgres-repository.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.core.json",
    "typecheck:app": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm run typecheck:app && npm run test && npm run build"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "next": "^16.2.7",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
