{
  "name": "muster",
  "version": "1.1.1",
  "description": "Crew engine for small-passenger-vessel operators",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "build:core": "tsc -p tsconfig.build.json",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx db/migrate.ts",
    "db:new-migration": "tsx db/new-migration.ts",
    "db:mint": "tsx db/mint-link.ts",
    "db:admin": "tsx db/admin.ts",
    "db:crew": "tsx db/crew.ts",
    "db:balance": "tsx db/balance-dev.ts",
    "db:pay": "tsx db/pay-dev.ts",
    "db:xola:report": "tsx db/xola-report.ts",
    "db:paid-unbooked": "tsx db/paid-unbooked-dev.ts",
    "db:backfill:customers": "tsx db/backfill-customers.ts",
    "db:seed:fleet": "tsx db/seed-fleet.ts",
    "db:seed:crew:pilot": "tsx db/seed-pilot-crew.ts",
    "db:seed:crew": "tsx db/seed-crewapp-dev.ts",
    "db:seed:atrisk": "tsx db/seed-atrisk-dev.ts",
    "db:seed:outbox": "tsx db/seed-outbox-dev.ts",
    "db:seed:split": "tsx db/seed-split-dev.ts",
    "db:seed:gratuity": "tsx db/seed-gratuity-dev.ts",
    "db:seed:reservation": "tsx db/seed-reservation-dev.ts",
    "db:seed:xola": "tsx db/seed-xola-dev.ts",
    "db:seed:overlap": "tsx db/seed-overlap-dev.ts",
    "db:seed:completion": "tsx db/seed-completion-dev.ts",
    "db:seed:losing-asks": "tsx db/seed-losing-asks-dev.ts",
    "db:seed:timeclock": "tsx db/seed-timeclock-dev.ts",
    "db:tick": "tsx db/tick-dev.ts",
    "db:doorbell": "tsx db/doorbell-dev.ts",
    "db:reset:dev": "tsx db/reset-dev.ts",
    "db:reset:test": "tsx db/reset-test.ts",
    "test": "vitest run",
    "test:pg": "vitest run src/adapters/postgres-repository.test.ts src/adapters/postgres-presence.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_PROD=1 playwright test",
    "test:e2e:dev": "E2E_PROD=0 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.core.json",
    "typecheck:app": "tsc -p tsconfig.json",
    "lint": "eslint app components",
    "gen:decisions": "node scripts/gen-decisions-index.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "check:context": "node scripts/check-context.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run check:decisions && npm run check:context && npm run check:docs && npm run typecheck && npm run typecheck:app && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "next": "^16.2.7",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.3.1"
  }
}
