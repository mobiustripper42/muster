{
  // Emit profile: compile only shippable source under src/ into dist/.
  // Excludes test files so they never land in the build output. Typechecking
  // (incl. *.config.ts and *.test.ts) is tsconfig.core.json's job.
  "extends": "./tsconfig.core.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
