{
  // Domain-core profile (DEC-013): the stack-agnostic core under src/ stays
  // strict ESM / NodeNext with .js import extensions, framework-free. This is the
  // config `npm run typecheck` uses and `tsconfig.build.json` extends. The Next
  // app has its OWN config (root tsconfig.json) — the two never share a profile,
  // which is how the core stays portable behind the Repository port (DEC-020).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // No `outDir`. It said "dist" until 2026-09-19 and did nothing — `noEmit` wins — but
    // it had already left 333 stale .js/.d.ts files there, the compiled remains of modules
    // deleted months earlier. Two sessions spent time asking why there was still an outbox
    // component; the answer was a build directory nobody emits to any more.
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // Core only — src/. Framework-coupled root config (next.config.ts) is checked
  // under the app profile (root tsconfig.json), not here; this profile is the
  // portable, framework-free core's validator and must stay that way.
  "include": ["src"],
  "exclude": ["node_modules", "dist", "app", ".next"]
}
