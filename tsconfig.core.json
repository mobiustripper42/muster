{
  // Domain-core profile (DEC-013): the stack-agnostic core under src/ stays
  // strict ESM / NodeNext with .js import extensions, framework-free. This is the
  // config `npm run typecheck` uses. The Next app has its OWN config (root
  // tsconfig.json) — the two never share a profile, which is how the core stays
  // portable behind the Repository port (DEC-020).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // Nothing here emits, and no profile extends this one to change that. `outDir` said
    // "dist" until 2026-09-19, did nothing under `noEmit`, and had still managed to leave
    // 333 stale .js/.d.ts files there — the compiled remains of modules deleted months
    // earlier, which cost two rounds of "why is there still an outbox component".
    // `tsconfig.build.json` and `build:core` went with it: private package, no `main` or
    // `exports`, nothing imported dist/, nothing ran the script. An emit profile with no
    // consumer only produces a directory to get confused by later.
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // Core only — src/. Framework-coupled root config (next.config.ts) is checked
  // under the app profile (root tsconfig.json), not here; this profile is the
  // portable, framework-free core's validator and must stay that way.
  "include": ["src"],
  "exclude": ["node_modules", "dist", "app", ".next"]
}
